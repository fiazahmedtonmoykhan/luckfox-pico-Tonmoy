#!/bin/sh

# Target directory path
DEST_DIR="/var/spool/cron"
SRC_DIR="/etc/cron"
echo "Checking for directory: $DEST_DIR"
if [ ! -d "$DEST_DIR" ]; then
    mkdir -p "$DEST_DIR"
    echo "Directory created: $DEST_DIR"
else
    echo "Directory already exists."
fi
# now copy crontab settings from src to dest

cp -r "$SRC_DIR/crontabs" "$DEST_DIR/crontabs"

crond -b