#!/bin/sh


log() {
    logger -t usb0-modem "$1"
}

log "Starting usb0 bring-up"

GPIO=4

# modem pwr control using GPIO
if [ ! -d /sys/class/gpio/gpio$GPIO ]; then
    echo $GPIO > /sys/class/gpio/export
fi

echo out > /sys/class/gpio/gpio$GPIO/direction
echo 1 > /sys/class/gpio/gpio$GPIO/value

ip link set usb0 up

sleep 2

LINK_UP=0
#if /sys/class/net/usb0 does not exists exit
for i in $(seq 1 3); do
    if [ ! -d /sys/class/net/usb0 ]; then
        log "usb0 interface not found"
    else
        log "usb0 interface available"
        LINK_UP=1
        break
    fi
    log "Wating for interface to available...($i)"
done

#if link was not successfully up, exit
if [ "$LINK_UP" -eq 0 ]; then
    log "Failed to init usb0 interface, exiting..."
    exit 1
fi



# Wait for carrier
for i in $(seq 1 30); do
    CARRIER=$(cat /sys/class/net/usb0/carrier 2>/dev/null)

    if [ "$CARRIER" = "1" ]; then
        log "Carrier detected"
        break
    fi

    log "Waiting for carrier... ($i)"
    sleep 1
done

# Flush old IP
ip addr flush dev usb0

sleep 1

# DHCP
log "Starting DHCP"

udhcpc -i usb0

ret=$?

sleep 2

if [ $ret -eq 0 ]; then
    log "DHCP success"
else
    log "DHCP failed"
fi

log "usb0 setup completed"